# Copia este archivo como .env y ajusta los valores.
# El .env real esta ignorado por git: nunca subas secretos ni hosts reales.

# --- Django ---
DEBUG=True
SECRET_KEY=cambia-esto-en-produccion

# Hosts desde los que se acepta servir. Separados por coma, sin espacios.
# Agrega aqui la IP del equipo si vas a entrar desde otra maquina de la red.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origenes donde corre el frontend (esquema + host + puerto).
# De aqui salen tanto CORS_ALLOWED_ORIGINS como CSRF_TRUSTED_ORIGINS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Base de datos (solo settings/prod.py, que usa SQL Server) ---
# settings/dev.py usa SQLite y no necesita nada de esto.
NAME=importadora
USER=sa
PASSWORD=
HOST=localhost
PORT=1433
DRIVER=ODBC Driver 17 for SQL Server
